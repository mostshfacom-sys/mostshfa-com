# ============================================
# PostgreSQL Database Configuration (Required for Vercel)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public"

# للإنتاج (Vercel PostgreSQL أو Supabase)
# DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# للاختبار (PostgreSQL منفصلة)
# TEST_DATABASE_URL="postgresql://username:password@localhost:5432/mostshfa_test?schema=public"

# ============================================
# Authentication
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth (اختياري)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# Google Services
# ============================================
# Google AdSense
NEXT_PUBLIC_ADSENSE_ID="ca-pub-xxxxxxxxxx"

# Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ============================================
# Site Configuration
# ============================================
NEXT_PUBLIC_SITE_URL="https://mostshfa.com"

# ============================================
# YouTube Configuration
# ============================================
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="UCtO6Nqx9EwJ8idDaLYR0E2w"

# ============================================
# Vercel + PostgreSQL Deployment Notes
# ============================================
# 1. أنشئ قاعدة بيانات PostgreSQL على Vercel أو Supabase
# 2. احصل على connection string من المزود
# 3. أضف DATABASE_URL في Vercel Environment Variables
# 4. تأكد من أن provider في schema.prisma هو "postgresql"
# 5. شغّل: npx prisma migrate deploy
